  spriteRenderer: {fileID: 3730187839858678294}
  greeting: {fileID: 11400000, guid: 32c91579db724f1fcabfb0b627ee3bd7, type: 2}
  riddleSpeaker: Old Wizard
  question: I am the path that has no stones, crossing vast kingdoms without ever
    moving. I can carry you to the highest elven towers or the deepest dwarven mines
    in the blink of an eye. What am I?
  answers:
  - Bridge
  - Portal
  - Map
  correctAnswer: 1
  correctReply:
    speaker: Old Wizard
    text: Wise indeed! The portal is yours. Farewell, traveller.
  wrongReply:
    speaker: Old Wizard
    text: Alas, no. The bridges it is, then. Watch your step.
  correctTitle: THE PORTAL AWAKENS
  correctHint: A shortcut has opened.
  wrongTitle: THE PORTAL STAYS CLOSED
  wrongHint: Cross the broken bridges.
  portalUnlocked:
    m_PersistentCalls:
