  m_Script: {fileID: 11500000, guid: 83f679b046e7912469a4521040da8c4d, type: 3}
  m_Name: WizardGreeting
  m_EditorClassIdentifier: Assembly-CSharp::Mossbound.Dialogue.DialogueData
  lines:
  - speaker: Old Wizard
    text: Ah, a traveller! Few find their way this deep into the mossy woods
  - speaker: Knight
    text: I seek the castle beyond the old bridges
  - speaker: Old Wizard
    text: Those bridges are broken and treacherous. Answer my riddle, and I shall
      open a shorter path
